{
  "allowlist_root_dirs": [
    ".openclaw",
    "brain",
    "copilots",
    "dashboard",
    "docs",
    "hooks",
    "logs",
    "memory",
    "openclaw",
    "ops",
    "plans",
    "repo_map",
    "scripts",
    "state",
    "templates",
    "tests",
    "vault",
    "workers"
  ],
  "allowlist_root_files": [
    ".gitignore",
    "AGENTS.md",
    "BOOT.md",
    "BOOTSTRAP.md",
    "CEO.md",
    "CLAUDE.md",
    "COMMAND_LOGGER.md",
    "HEARTBEAT.md",
    "IDENTITY.md",
    "INDEX.md",
    "PROJECT_BRIEF.md",
    "README.md",
    "REPO_MAP.md",
    "SESSION_MEMORY.md",
    "SOUL.md",
    "TOOLS.md",
    "USER.md",
    "dashboard_server.py",
    "hq_logging.py",
    "index_docs.py",
    "otto_state.py",
    "pytest.ini",
    "requirements.txt"
  ],
  "canonical_root": "/home/agente/otto-workspace",
  "ignore_globs": [
    ".git/**",
    ".pytest_cache/**",
    ".venv/**",
    "__pycache__/**",
    "build/**",
    "dist/**",
    "hooks/**/.cache/**",
    "hooks/**/dist/**",
    "hooks/**/node_modules/**",
    "node_modules/**",
    "vault/inbox_raw/**",
    "vault/_quarantine/**",
    "vault/_salvage/**"
  ],
  "obvio_junk_patterns_home": [
    "(?i)^_OLD_BAD_PATH_BACKUP",
    "(?i)c:\\\\",
    "(?i):\\\\",
    "(?i)\\\\users\\\\",
    "(?i)quarantine",
    "(?i)salvage"
  ],
  "sensitive_name_patterns": [
    "(?i)api[ _-]*key",
    "(?i)credential",
    "(?i)password",
    "(?i)private[ _-]*key",
    "(?i)secret",
    "(?i)token"
  ],
  "sensitive_path_exclusions": [
    "tests/**"
  ],
  "tooling_dirs": [
    ".claude",
    ".codex",
    ".git",
    ".idea",
    ".pytest_cache",
    ".venv",
    ".vscode",
    "__pycache__",
    "build",
    "dist",
    "node_modules"
  ],
  "version": 1
}
